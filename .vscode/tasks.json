{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Watch articles and rebuild social images",
      "type": "process",
      "command": "${command:python.interpreterPath}",
      "args": ["${workspaceFolder}/scripts/watch_articles.py"],
      "isBackground": true,
      "problemMatcher": {
        "owner": "article-social-previews",
        "pattern": {
          "regexp": "^$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^Rebuilding site and article social images\\.\\.\\.$",
          "endsPattern": "^Stopped article watcher\\.$"
        }
      },
      "runOptions": {
        "runOn": "folderOpen"
      }
    }
  ]
}
